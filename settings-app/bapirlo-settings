#!/usr/bin/env python3
"""Kuro OS — Settings: every Kuro switch in one place, and an Undo list (GTK4 + libadwaita).

  bapirlo-settings            open it
  bapirlo-settings --page=undo   open on a page (extensions, modes, power, screentime, undo)
  bapirlo-settings --undo     list the backups and their restore commands (terminal, no window)

Pages
  Extensions  every *@bapirlo-os extension: on/off, plus its settings made from its own schema
              (switches, sliders, choices, text; shortcuts shown read-only — Super+/ lists them all).
              Changes apply live; internal state keys and lists that have their own editor are left out.
  Modes       Gaming / Quiet / Do Not Disturb (bapirlo-mode), Bedtime (bapirlo-bedtime), tools (doctor, update, Studio,
              Wallpapers, Welcome), recent colours from the picker (Super+Shift+C), ruler (Super+Shift+M).
  Battery     level, watts in/out, last 24 h, health, 80 % limit, power mode   (kuro_pages.py)
  Screen time today, last 7 days, top apps (counted by the desk extension, local files)
  Undo        each ~/theme-backups/LATEST-* with the command that puts it back: the backup's own
              restore.sh, or the script that made it with "restore". It runs in a terminal (sudo asks
              there), only after you confirm. Backups with no known command get "Open folder".

Nothing runs while the window is closed.
"""
import datetime
import json
import os
import re
import shlex
import subprocess
import sys
import threading

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
BIN = os.path.join(ROOT, "bin")
HOME = os.path.expanduser("~")
BACKUPS = os.path.join(HOME, "theme-backups")
EXT_DIR = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share")),
                       "gnome-shell/extensions")
COLOURS = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")),
                       "bapirlo/colours.txt")
APP_ID = "os.bapirlo.Settings"

# state the extensions write for themselves, and lists that have their own editor
HIDE = {
    "bapirlo-bar": {"focus-phase", "focus-end", "focus-left", "focus-total", "focus-started",
                    "focus-owns-dnd", "focus-request"},
    "bapirlo-desk": {"briefing-last"},
}
ACCEL = re.compile(r"^(<[A-Za-z0-9_]+>)+[^<>\s]+$")
MODS = {"Super": "Super", "Shift": "Shift", "Control": "Ctrl", "Ctrl": "Ctrl", "Primary": "Ctrl", "Alt": "Alt"}


# ============================================================================ undo list (no GTK)
def _backup_dir(link):
    try:
        if os.path.islink(link) or os.path.isdir(link):
            return os.path.realpath(link)
        with open(link) as f:          # some LATEST-* are a file holding the path
            p = f.read().strip()
        return p if os.path.isdir(p) else None
    except OSError:
        return None


def _when(d):
    m = re.match(r"(\d{8})-(\d{6})", os.path.basename(d))
    try:
        if m:
            return datetime.datetime.strptime(m.group(1) + m.group(2), "%Y%m%d%H%M%S")
        return datetime.datetime.fromtimestamp(os.path.getmtime(d))
    except (OSError, ValueError):
        return datetime.datetime.fromtimestamp(0)


def _needs_root(text):
    return '-eq 0 ] ||' in text and '-ne 0 ] ||' not in text


_SCRIPTS = None


def _scripts():
    global _SCRIPTS
    if _SCRIPTS is None:
        _SCRIPTS = []
        for dp, dns, fns in os.walk(ROOT):
            dns[:] = [d for d in dns if d not in ("src", "build", ".git", "node_modules", "vendor", "__pycache__")]
            for fn in fns:
                if fn.endswith(".sh"):
                    p = os.path.join(dp, fn)
                    try:
                        with open(p, errors="replace") as f:
                            _SCRIPTS.append((p, f.read()))
                    except OSError:
                        pass
        _SCRIPTS.sort()
    return _SCRIPTS


def restore_command(name, d):
    """(argv, needs_root) that undoes backup NAME, or (None, False)."""
    own = os.path.join(d, "restore.sh")
    if os.path.isfile(own):
        with open(own, errors="replace") as f:
            return ["bash", own], _needs_root(f.read())
    word = re.compile(re.escape(name) + r"(?![A-Z0-9-])")
    for path, text in _scripts():          # a dedicated undo script (restore-boot-v2.sh) wins
        if os.path.basename(path).startswith("restore") and word.search(text):
            return ["bash", path], _needs_root(text)
    for path, text in _scripts():
        # the script that WRITES this LATEST link (LATEST=…, ln -s …, echo … > …), not one that only reads it
        if not any(word.search(line) and re.search(r"LATEST=|ln -s|> *\"", line) for line in text.splitlines()):
            continue
        # only if the script really has that mode — running an install script without it would re-apply it
        if name.endswith("-ROOT") and _handles(text, "restore-root"):
            return ["bash", path, "restore-root"], True
        if _handles(text, "restore"):
            return ["bash", path, "restore"], _needs_root(text)
    return None, False


def _handles(text, mode):
    m = re.escape(mode)
    return bool(re.search(rf'(\$\{{?1[^=\n]*=+ *"?{m}"?(?![\w-]))|((^|[\s|"(]){m}"?\))', text, re.M))


def backups():
    out = []
    try:
        names = sorted(n for n in os.listdir(BACKUPS) if n.startswith("LATEST"))
    except OSError:
        return out
    for n in names:
        d = _backup_dir(os.path.join(BACKUPS, n))
        if not d:
            continue
        cmd, root = restore_command(n, d)
        title = n[len("LATEST-"):] if n != "LATEST" else "System (first backup)"
        title = title.replace("-", " ").title().replace("Gnome", "GNOME").replace("Grub", "GRUB").replace("Ai ", "AI ").replace("Cc ", "CC ").replace("Ws ", "Workspace ")
        title = re.sub(r"Round(\d)", r"Round \1", title)
        out.append({"name": n, "title": title, "dir": d, "when": _when(d), "cmd": cmd, "root": root})
    out.sort(key=lambda b: b["when"], reverse=True)
    return out


def command_text(b):
    return ("sudo " if b["root"] else "") + " ".join(shlex.quote(a) for a in b["cmd"]).replace(HOME, "~")


if __name__ == "__main__" and "--undo" in sys.argv:
    for b in backups():
        print(f"{b['when']:%Y-%m-%d %H:%M}  {b['title']:<26} {command_text(b) if b['cmd'] else '(no restore command — see ' + b['dir'] + ')'}")
    sys.exit(0)

