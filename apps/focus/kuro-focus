#!/usr/bin/env python3
"""Kuro OS — Kuro Focus: the focus timer, Focus Lock and the iPhone lock in one app (GTK4 + libadwaita).

  kuro-focus                 open it
  kuro-focus --page=apps     open on a page (timer, apps, iphone)

Pages
  Timer    start / pause / stop a block (it runs in the top bar — Super+Alt+F does the same), focus on a
           Lectern module (counts in Lectern's study log), today / this week / streak.
  Apps     Focus Lock on/off and which apps stay usable during a block (everything else is minimised).
  iPhone   the answer server for the iPhone Shortcuts automation: on/off, the link + QR code, the steps,
           a new secret link.
The timer lives in the Kuro Bar and the lock in the Kuro Study extension; this window only changes their
settings, so closing it changes nothing.
"""
import os
import subprocess
import sys
import tempfile
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
BIN = os.path.join(ROOT, "bin")
sys.path.insert(0, os.path.join(ROOT, "lib"))
import bapirlo_focus as focus  # noqa: E402

APP_ID = "os.bapirlo.Focus"
EXT_DIR = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
                       "gnome-shell", "extensions")
STUDY_SCHEMA = "org.gnome.shell.extensions.bapirlo-study"
ALWAYS = "lectern.desktop"
UNIT = "kuro-phone-focus.service"

