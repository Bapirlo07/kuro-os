[Unit]
Description=Kuro Guardian — turns your extensions back on after a crash, minus the one that caused it
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/bapirlo-os/bin/kuro-guardian daemon
Restart=always
RestartSec=10
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=graphical-session.target
