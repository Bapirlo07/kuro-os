[Unit]
Description=Kuro Knock — knock patterns on the desk (bapirlo-knock on|off)
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 -I %h/bapirlo-os/knock/kuro-knock.py
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=graphical-session.target
