#!/usr/bin/env python3
"""Kuro OS — Focus Lock for the iPhone. Your iPhone asks this PC "am I in a focus block?" whenever you open
a distracting app; if yes, an iOS Shortcuts automation sends you back to the Home Screen (Opal-style).
  kuro-phone-focus setup     print the link + QR code and the steps for the Shortcuts automation
  kuro-phone-focus serve     run the tiny answer server (the kuro-phone-focus user service does this)
  kuro-phone-focus links     the links, one per line (the .local name first)
  kuro-phone-focus status    what the phone would be told right now
  kuro-phone-focus new-key   make a new secret link (the old one stops working)
The server answers on port 1764 (inside the LAN-only KDE Connect range the firewall already allows), only
at /focus/<secret key>, with one word: "focus 18" (minutes left), "break" or "idle". Nothing else is shared.
Away from this PC's network the phone simply can't ask, and the app opens normally.
"""
import http.server
import os
import secrets
import socket
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import bapirlo_focus as focus  # noqa: E402

PORT = int(os.environ.get("KURO_PHONE_FOCUS_PORT", "1764"))
KEY_FILE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                        "bapirlo", "phone-focus-key")


def key():
    try:
        with open(KEY_FILE, encoding="utf-8") as f:
            k = f.read().strip()
        if len(k) >= 10:
            return k
    except OSError:
        pass
    return new_key()


def new_key():
    k = secrets.token_urlsafe(9)
    os.makedirs(os.path.dirname(KEY_FILE), exist_ok=True)
    fd = os.open(KEY_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(k + "\n")
    return k


_cache = {"at": 0.0, "text": "idle"}
_lock = threading.Lock()


def answer():
    """'focus N' / 'break' / 'idle' — cached for 2 s so a busy phone can't make us spawn gsettings a lot."""
    with _lock:
        now = time.monotonic()
        if now - _cache["at"] > 2:
            st = focus.state() or {"phase": ""}
            if st["phase"] == "focus":
                _cache["text"] = f"focus {max(1, (st['left'] + 59) // 60)}"
            else:
                _cache["text"] = st["phase"] or "idle"
            _cache["at"] = now
        return _cache["text"]


def serve():
    secret = key()
    path = f"/focus/{secret}"

    class H(http.server.BaseHTTPRequestHandler):
        server_version = "kuro"
        sys_version = ""

        def do_GET(self):
            ok = secrets.compare_digest(self.path.split("?")[0].rstrip("/"), path)
            body = (answer() if ok else "not found").encode()
            self.send_response(200 if ok else 404)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *_):
            pass

    class S(http.server.ThreadingHTTPServer):
        address_family = socket.AF_INET6
        daemon_threads = True

        def server_bind(self):
            self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)   # IPv4 too
            super().server_bind()

    srv = S(("::", PORT), H)
    srv.timeout = 5
    print(f"kuro-phone-focus: answering on port {PORT}", flush=True)
    srv.serve_forever()


def addresses():
    out = []
    try:
        r = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"], capture_output=True,
                           text=True, timeout=5)
        for line in r.stdout.splitlines():
            parts = line.split()
            if len(parts) > 3:
                out.append((parts[1], parts[3].split("/")[0]))
    except (OSError, subprocess.SubprocessError):
        pass
    return out


def links():
    k = key()
    return [f"http://{socket.gethostname()}.local:{PORT}/focus/{k}"] + \
        [f"http://{ip}:{PORT}/focus/{k}" for _dev, ip in addresses()]


def setup():
    k = key()
    main = links()[0]
    print("Kuro Focus Lock — iPhone setup (one time, about 2 minutes)\n")
    print("Link for the Shortcut (scan the QR with the iPhone camera to copy it):")
    print(f"  {main}")
    for dev, ip in addresses():
        print(f"  or http://{ip}:{PORT}/focus/{k}      ({dev} address — use this if the .local link fails)")
    try:
        subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "1", main], check=False)
    except OSError:
        pass
    print("""
On the iPhone, open Shortcuts → Automation → + → App:
  1. Choose the apps to block (Instagram, TikTok, YouTube, games …), keep "Is Opened",
     pick "Run Immediately", switch "Notify When Run" off → Next → New Blank Automation.
  2. Add "Get Contents of URL" → paste the link above.
  3. Add "If" → Contents of URL → "contains" → focus
  4. Inside the If, add "Show Notification": "Focus block running — back to it 📚"
     and then "Go to Home Screen". Leave Otherwise empty. Done.
Test: start a focus block on the PC (Super+Alt+F), open one of those apps → you land back on the Home Screen.
Off the PC's Wi-Fi (or with the PC asleep) the check fails quietly and the app just opens.""")
    st = subprocess.run(["systemctl", "--user", "is-active", "kuro-phone-focus.service"],
                        capture_output=True, text=True).stdout.strip()
    if st != "active":
        print("\n!! The answer server isn't running: systemctl --user enable --now kuro-phone-focus.service")
    return 0


def main(argv):
    verb = argv[0] if argv else "setup"
    if verb == "serve":
        serve()
        return 0
    if verb == "setup":
        return setup()
    if verb == "links":
        print("\n".join(links()))
        return 0
    if verb == "status":
        print(answer())
        return 0
    if verb == "new-key":
        new_key()
        subprocess.run(["systemctl", "--user", "try-restart", "kuro-phone-focus.service"], check=False)
        print("New link made — run `kuro-phone-focus setup` and paste it into the Shortcut again.")
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
