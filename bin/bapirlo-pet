#!/usr/bin/env python3
"""Kuro creature: bapirlo-pet hide | show | toggle | status   (writes ~/.config/bapirlo/pet.json)"""
import json, os, sys
from pathlib import Path
CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "bapirlo" / "pet.json"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "bapirlo" / "pet.json"
try:
    c = json.loads(CONF.read_text())
except Exception:
    c = {"visible": True}
cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
if cmd in ("hide", "show", "toggle"):
    c["visible"] = {"hide": False, "show": True}.get(cmd, not c.get("visible", True))
    CONF.parent.mkdir(parents=True, exist_ok=True)
    CONF.write_text(json.dumps(c, indent=1))
try:
    s = json.loads(STATE.read_text())
except Exception:
    s = {}
days = len(s.get("days", []))
stage = sum(days >= n for n in (3, 10, 30))
print(f"Kuro is {'out' if c.get('visible', True) else 'hiding'} · {days} days together · stage {stage}/3 · petted {s.get('pets', 0)}×")
