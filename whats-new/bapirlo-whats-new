class WhatsNew(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        if getattr(self, "win", None):
            self.win.present()
            return
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        prov = Gtk.CssProvider()
        prov.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.win = Adw.ApplicationWindow(application=self, title="What's new in Kuro OS", default_width=980,
                                         default_height=860)
        self.win.add_css_class("kuro-new")
        self.win.connect("close-request", self.on_close)
        view = Adw.ToolbarView()
        hb = Adw.HeaderBar(show_title=False)
        hb.add_css_class("flat")
        view.add_top_bar(hb)
        self.toast = Adw.ToastOverlay()
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_start=26, margin_end=26,
                       margin_bottom=26)
        scroll.set_child(Adw.Clamp(maximum_size=1000, child=page))
        self.toast.set_child(scroll)
        view.set_content(self.toast)
        self.win.set_content(view)

        hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        hero.add_css_class("hero")
        hero.append(self.label("KURO OS · ROUNDS 22 + 23 · COSMOS & FLOW", "brand"))
        hero.append(self.label("What's new", "title"))
        hero.append(self.label("Eleven cosmic upgrades and ten that get things done faster. Everything with a "
                               "switch is on except the aurora sky — flip any of them here.", "sub", wrap=True))
        page.append(hero)

        self.switches = {}
        self._syncing = False
        page.append(self.label("COSMOS", "brand", margin_top=6))
        for num, title, what, how, buttons, service, note in features(self):
            page.append(self.card(num, title, what, how, buttons, service, note))
        page.append(self.label("FLOW", "brand", margin_top=14))
        for num, title, what, how, buttons, service, note in features23(self):
            page.append(self.card(num, title, what, how, buttons, service, note))

        foot = Gtk.Box(spacing=10, margin_top=6)
        foot.append(self.label("Open this again any time: type “what's new” in search.", "footer", hexpand=True))
        done = Gtk.Button(label="Got it")
        done.add_css_class("kuro")
        done.add_css_class("accent")
        done.connect("clicked", lambda *_: self.win.close())
        foot.append(done)
        page.append(foot)

        self.win.present()
        GLib.timeout_add_seconds(3, self.refresh)

    # ---------- pieces ----------
    def label(self, text, *css, wrap=False, xalign=0.0, **kw):
        lbl = Gtk.Label(label=text, xalign=xalign, wrap=wrap, **kw)
        if wrap:
            lbl.set_wrap_mode(2)            # WORD_CHAR
        for c in css:
            lbl.add_css_class(c)
        return lbl

    def how_row(self, parts):
        """Plain text with keys / commands (tuples) highlighted."""
        text = []
        for p in parts:
            if isinstance(p, tuple):
                text.append(" ".join(k if k == "+" else
                                     f'<span font_family="monospace" weight="bold" foreground="#FF4655">'
                                     f'{GLib.markup_escape_text(k)}</span>' for k in p))
            else:
                text.append(GLib.markup_escape_text(p))
        lbl = Gtk.Label(xalign=0, wrap=True)
        lbl.set_markup("".join(text))
        lbl.add_css_class("how")
        return lbl

    def card(self, num, title, what, how, buttons, service, note):
        c = Gtk.Box(spacing=14)
        c.add_css_class("card")
        c.append(self.label(num, "num", valign=Gtk.Align.START))
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, hexpand=True)
        top = Gtk.Box(spacing=10)
        top.append(self.label(title, "heading", hexpand=True))
        if service:
            st = self.label("", "state")
            sw = Gtk.Switch(valign=Gtk.Align.CENTER)
            sw.connect("state-set", lambda s, on, svc=service: self.toggle(svc, on))
            top.append(st)
            top.append(sw)
            self.switches[service] = (sw, st)
        col.append(top)
        col.append(self.label(what, "what", wrap=True))
        col.append(self.how_row(how))
        if note:
            col.append(self.label(note, "note", wrap=True))
        if buttons:
            row = Gtk.Box(spacing=8, margin_top=4)
            for text, fn, accent in buttons:
                bt = Gtk.Button(label=text)
                bt.add_css_class("kuro")
                if accent:
                    bt.add_css_class("accent")
                bt.connect("clicked", lambda *_, f=fn: f())
                row.append(bt)
            col.append(row)
        c.append(col)
        if service:
            self.refresh_one(service)
        return c

    # ---------- actions ----------
    def later(self, fn):
        """Things that happen on the desktop: tuck this window away first."""
        self.win.minimize()
        GLib.timeout_add(450, lambda: (fn(), False)[1])

    def cmd(self, service, *args):
        first, *rest = service.split()
        return [b(first), *rest, *args]

    def toggle(self, service, on):
        if self._syncing:
            return False
        launch(self.cmd(service, "on" if on else "off"))
        GLib.timeout_add(1500, lambda: (self.refresh_one(service), False)[1])
        return False

    def refresh_one(self, service):
        sw, st = self.switches[service]
        on = out(self.cmd(service, "status")) == "on"
        if sw.get_active() != on:
            self._syncing = True                 # showing the real state must not flip the service
            sw.set_active(on)
            self._syncing = False
        st.set_label("ON" if on else "OFF")
        (st.add_css_class if on else st.remove_css_class)("on")

    def refresh(self):
        if not getattr(self, "win", None):
            return False
        for svc in self.switches:
            self.refresh_one(svc)
        return True

    def check_phone(self):
        s = phone_state()
        if s.startswith("connected"):
            msg = f"📱 {s[10:]} is connected — throw a window at the top edge!"
        elif s.startswith("paired"):
            msg = f"📱 {s[7:]} is paired but not connected — open KDE Connect on it"
        else:
            msg = "📱 No phone paired in GSConnect yet"
        self.toast.add_toast(Adw.Toast(title=msg, timeout=5))

    def on_close(self, *_):
        os.makedirs(STATE, exist_ok=True)
        with open(SEEN, "w", encoding="utf-8") as f:
            f.write(ROUND + "\n")
        return False


def main():
    if "--once" in sys.argv:
        try:
            with open(SEEN, encoding="utf-8") as f:
                if f.read().strip() == ROUND:
                    return 0
        except OSError:
            pass
        sys.argv.remove("--once")
    return WhatsNew().run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
