def launch(cmd):
    try:
        subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def out(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def b(name):
    return os.path.join(BIN, name)


def gdbus(dest, path, method):
    launch(["gdbus", "call", "--session", "-d", dest, "-o", path, "-m", method])


def terminal(title, *cmd):
    term = shutil.which("alacritty")
    if term:
        launch([term, "-T", title, "-e", *cmd])
    else:
        launch(["kgx", "--", *cmd])


def phone_state():
    """'connected NAME' | 'paired NAME' | ''"""
    o = out(["gdbus", "call", "--session", "-d", "org.gnome.Shell.Extensions.GSConnect",
             "-o", "/org/gnome/Shell/Extensions/GSConnect", "-m", "org.freedesktop.DBus.ObjectManager.GetManagedObjects"])
    import re
    name = re.search(r"'Name': <'([^']+)'>", o)
    if not name:
        return ""
    return ("connected " if "'Connected': <true>" in o else "paired ") + name.group(1)


